---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
const breed = await getEntry('breed', 'about');
const { Content } = await render(breed!);
---
<BaseLayout title="The Breed — Coco's Puppy Tales" description="About Bernese Mountain Dogs and what to expect as an owner.">
  <section class="section">
    <div class="container prose-page">
      <Content />
      <p class="cta-line"><a class="btn" href="/waitlist">Sounds like your dog? Take one home →</a></p>
    </div>
  </section>
</BaseLayout>
<style>
  .prose-page { max-width: 760px; }
  .cta-line { margin-top: 2rem; }
</style>
