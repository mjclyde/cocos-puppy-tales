---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import PuppyDetails from '../components/PuppyDetails.astro';
import { getEntry } from 'astro:content';

const litter = await getEntry('litter', 'litter');
const site = await getEntry('site', 'config');
const showPricing = site!.data.flags.showPricing;
const description = showPricing
  ? "Pricing, what comes with a puppy, and how to bring one of Coco's puppies home."
  : "What comes with a puppy, and how to bring one of Coco's puppies home.";
---
<BaseLayout title="Take one home — Coco's Puppy Tales" description={description}>
  <section class="section">
    <div class="container">
      <h1>Take one home</h1>
      <p>Coco's puppies are ready for their families now. Here's everything that comes with one — then tell us about your home. We read every submission and reach out personally.</p>

      {litter && (
        <PuppyDetails
          goHomeDate={litter.data.goHomeDate}
          price={litter.data.price}
          deposit={litter.data.deposit}
          depositMethods={litter.data.depositMethods}
          healthGuarantee={litter.data.healthGuarantee}
          goesHomeWith={litter.data.goesHomeWith}
          raisingHighlights={litter.data.raisingHighlights}
          matchingNote={litter.data.matchingNote}
          showPricing={showPricing}
        />
      )}

      <WaitlistForm />
    </div>
  </section>
</BaseLayout>
