---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CountdownTimer from '../components/CountdownTimer.astro';
import LitterAge from '../components/LitterAge.astro';
import PuppyCard from '../components/PuppyCard.astro';
import TrustBadges from '../components/TrustBadges.astro';
import PawIcon from '../components/PawIcon.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { getEntry } from 'astro:content';
import { photosBySubject, withCoverFirst } from '../lib/photos';
import { availabilityLine } from '../lib/availability';

const coco = await getEntry('coco', 'coco');
const site = await getEntry('site', 'config');
const { dueDate, litterEstimate, location, badges, flags, cardCoverShoot } = site!.data;

const litterEntry = await getEntry('litter', 'litter');
// Gate on `published`: the home page introduces the puppies once the litter is
// live, and falls back to the pre-birth countdown otherwise. `/` can never
// redirect to itself, so both states must render here.
const litter = litterEntry?.data.published ? litterEntry.data : null;
const pageDescription = litter
  ? `Meet Coco's ${litter.count} Bernese Mountain Dog puppies — family raised in ${location}, vet checked, and ready for their families.`
  : undefined;
const pageOgImage = litter ? '/og-litter.jpg' : undefined;

// Validate and index against every collar in the content, published or not —
// the photo tree does not change when the announcement is toggled off.
const photos = photosBySubject((litterEntry?.data.collars ?? []).map((c) => c.name));

// Derived from the collar statuses, not typed by hand: it names the last puppy
// while one is open, counts them while several are, and disappears on its own
// once the litter is fully spoken for.
const availability = litter ? availabilityLine(litter.collars) : null;
---
<BaseLayout title="Coco's Puppy Tales" description={pageDescription} ogImage={pageOgImage}>
  {litter ? (
    <>
      <section class="section intro">
        <div class="container">
          <p class="eyebrow">Bernese Mountain Dog</p>
          <h1>{litter.headline}</h1>
          <div class="meta">
            <LitterAge bornDate={litter.bornDate} />
            <span class="where">{location}</span>
          </div>
          {availability && (
            <p class="availability"><PawIcon /> {availability}</p>
          )}
          <p class="tagline">{litter.tagline}</p>
          <TrustBadges badges={badges} />
          <a class="btn intro-cta" href="/waitlist">Take one home →</a>
        </div>
      </section>

      <section class="section cast-section">
        <div class="container">
          <h2>Every collar, a different personality</h2>
          <div class="cast">
            {litter.collars.map((c) => (
              <PuppyCard
                name={c.name}
                hex={c.hex}
                sex={c.sex}
                status={c.status}
                note={c.note}
                photos={withCoverFirst(photos[c.name.toLowerCase()] ?? [], cardCoverShoot)}
              />
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="cta">
            <h2>Is one of them yours?</h2>
            <p>Tell us about your home and we'll help match you with the pup who fits it.</p>
            <a class="btn" href="/waitlist">Take one home →</a>
          </div>
        </div>
      </section>
    </>
  ) : (
    <>
      <Hero image={coco!.data.heroImage} name={coco!.data.name} />

      <section class="section countdown-section">
        <div class="container">
          <h2>Expected arrival</h2>
          <p>We're expecting {litterEstimate}! Here's the countdown:</p>
          <CountdownTimer targetDate={dueDate} />
        </div>
      </section>
    </>
  )}

  {flags.showSubscribe && (
    <section class="section subscribe-section">
      <div class="container">
        <h2>Follow along</h2>
        <p>Not ready for a puppy today? Get an email when there's big news.</p>
        <SubscribeForm />
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .intro h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0.6rem 0 0; max-width: 22ch; }
  /* Age chip and location share a baseline row; they wrap together on narrow screens. */
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 0.9rem; margin: 1rem 0 0; }
  .where { color: var(--c-charcoal); font-size: 0.95rem; font-weight: 800; }
  .eyebrow { color: var(--eyebrow); font-size: 0.8rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 0.35rem; }
  /* `--eyebrow` rather than `--c-brown`: this line is body-sized, and the plain
     brown clears only 4.33:1 on cream. */
  .tagline { color: var(--eyebrow); font-size: 1.1rem; font-weight: 800; margin: 0.9rem 0 0; }
  /* Outlined, not filled: `.btn` is already a solid `--pop` pill, so a honey
     fill here would read as a second button competing with "Take one home".
     The border carries the accent, white keeps it an announcement, and charcoal
     on white is the page's highest-contrast pairing. */
  .availability {
    align-items: center;
    background: #fff;
    border: 2px solid var(--pop);
    border-radius: var(--radius-pill);
    color: var(--c-charcoal);
    display: inline-flex;
    font-size: 1rem;
    font-weight: 900;
    gap: 0.5rem;
    margin: 1.2rem 0 0;
    padding: 0.55rem 1.1rem;
  }
  /* The paw picks up the accent the fill gave up. */
  .availability :global(svg) { color: var(--eyebrow); }
  .intro-cta { margin: 1.5rem 0 0; }
  .cast-section { background: #fff; }
  /* Fixed three columns rather than auto-fit: nine puppies land as a clean 3×3,
     the same arrangement as the printed flyer, instead of a 4-4-1 with an
     orphan in the last row. */
  .cast { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  @media (max-width: 860px) { .cast { grid-template-columns: repeat(2, 1fr); } }
  .cta { background: var(--c-sage-deep); color: #fff; border-radius: var(--radius); padding: 2rem; text-align: center; }
  .cta h2 { color: #fff; }
  .cta p { margin: 0.25rem 0 1.25rem; }
  .subscribe-section { background: #fff; }
</style>
