---
---
<form class="subscribe" id="subscribe-form" action="/api/subscribe" method="POST">
  <label class="visually-hidden" for="sub-email">Email address</label>
  <input id="sub-email" name="email" type="email" required placeholder="you@example.com" />
  <button class="btn" type="submit">Get updates</button>
  <p class="msg" id="sub-msg" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('subscribe-form') as HTMLFormElement | null;
  const msg = document.getElementById('sub-msg');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!msg) return;
    msg.textContent = 'Subscribing…';
    try {
      const res = await fetch('/api/subscribe', { method: 'POST', body: new FormData(form) });
      const data = await res.json();
      msg.textContent = data.ok ? data.message : data.error;
      if (data.ok) form.reset();
    } catch {
      msg.textContent = 'Something went wrong. Please try again.';
    }
  });
</script>

<style>
  .subscribe { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; }
  .subscribe input { padding: 0.85rem 1.25rem; border-radius: var(--radius-pill); border: 2px solid var(--c-navy); min-width: 240px; font: inherit; font-size: 1.05rem; transition: border-color 0.12s ease, box-shadow 0.12s ease; }
  .subscribe input:focus-visible { outline: none; border-color: var(--c-honey); box-shadow: 0 0 0 3px rgba(233, 185, 73, 0.35); }
  /* Scale the button up to match the input's heft; transparent 2px border keeps both pills the same height */
  .subscribe .btn { border: 2px solid transparent; padding: 0.85rem 2.1rem; font-size: 1.05rem; }
  .msg { width: 100%; margin: 0.5rem 0 0; font-weight: 700; color: var(--c-sage); }
</style>
