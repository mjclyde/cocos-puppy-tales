---
// Wraps a slotted <Image> thumbnail in a PhotoSwipe anchor so it can be opened
// in the site-wide lightbox. The anchor is `display: contents` (see global.css),
// so it adds no layout box — the slotted image keeps all its own styling.
//
// `src` is passed here (in addition to the slotted <Image>) only so we can build
// a larger, optimized variant for the enlarged view. The anchor's href doubles
// as a no-JS fallback: it just opens that large image.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
}

const { src } = Astro.props;

const MAX_WIDTH = 1600;
const largeWidth = Math.min(MAX_WIDTH, src.width);
const largeHeight = Math.round((largeWidth * src.height) / src.width);
const large = await getImage({ src, width: largeWidth, format: 'webp', quality: 82 });
---
<a class="pswp-item" href={large.src} data-pswp-width={largeWidth} data-pswp-height={largeHeight}>
  <slot />
</a>
