---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface PuppyGrowth {
  eyebrow: string;
  title: string;
  facts: { label: string; text: string }[];
}
interface Props {
  week: number;
  title: string;
  date: Date;
  bellySizeComparison?: string;
  bellyPhoto?: ImageMetadata;
  puppyGrowth?: PuppyGrowth;
}
const { week, title, date, bellySizeComparison, bellyPhoto, puppyGrowth } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const hasPhoto = Boolean(bellyPhoto);
---
<article class={`card update${hasPhoto ? ' has-photo' : ''}`}>
  {bellyPhoto && <Image src={bellyPhoto} alt={`Coco at week ${week}`} class="update-img" widths={[400, 800]} sizes="(max-width: 700px) 100vw, 320px" format="webp" quality={80} loading="lazy" />}
  <div class="update-body">
    <div class="meta">
      <span class="chip">Week {week}</span>
      <span class="date">{dateStr}</span>
    </div>
    <h3>{title}</h3>
    {bellySizeComparison && <p class="belly">Belly size: <strong>{bellySizeComparison}</strong></p>}
    <div class="prose"><slot /></div>
  </div>
  {puppyGrowth && (
    <section class="puppy-growth" aria-label={`Week ${week} puppy growth`}>
      <p class="puppy-growth__eyebrow">{puppyGrowth.eyebrow}</p>
      <h4>{puppyGrowth.title}</h4>
      <ul>
        {puppyGrowth.facts.map((fact) => (
          <li><strong>{fact.label}:</strong> {fact.text}</li>
        ))}
      </ul>
    </section>
  )}
</article>
<style>
  .update { display: grid; grid-template-columns: 1fr; gap: 1.25rem; align-items: start; margin-bottom: 1.5rem; }
  .update.has-photo { grid-template-columns: minmax(0, 1fr) 320px; }
  .update.has-photo .update-img { grid-column: 2; grid-row: 1; }
  .update.has-photo .update-body { grid-column: 1; grid-row: 1; }
  .update.has-photo .puppy-growth { grid-column: 1 / -1; }
  .update-img { border-radius: var(--radius); width: 100%; height: auto; object-fit: cover; }
  .meta { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.4rem; }
  .date { color: var(--c-brown); font-weight: 700; font-size: 0.9rem; }
  .belly { margin: 0.25rem 0 0.5rem; }
  .puppy-growth {
    background: color-mix(in srgb, var(--c-cream) 78%, #fff);
    border: 2px solid color-mix(in srgb, var(--c-sage) 38%, #fff);
    border-radius: var(--radius);
    padding: 1rem;
  }
  .puppy-growth__eyebrow {
    color: var(--c-brown);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0;
    margin: 0 0 0.35rem;
    text-transform: uppercase;
  }
  .puppy-growth h4 {
    color: var(--heading);
    font-size: 1.08rem;
    margin: 0 0 0.65rem;
  }
  .puppy-growth ul {
    display: grid;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .puppy-growth li {
    padding-left: 1.4rem;
    position: relative;
  }
  .puppy-growth li::before {
    background: var(--c-sage);
    border-radius: 999px;
    content: "";
    height: 0.5rem;
    left: 0;
    position: absolute;
    top: 0.58rem;
    width: 0.5rem;
  }
  @media (max-width: 700px) {
    .update.has-photo { grid-template-columns: 1fr; }
    .update.has-photo .update-img,
    .update.has-photo .update-body { grid-column: auto; grid-row: auto; }
  }
</style>
