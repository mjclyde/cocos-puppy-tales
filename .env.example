# Supabase (server-side only — never expose the service role key to the client)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Newsletter unsubscribe-link signing secret (server-side only — never expose to the client)
NEWSLETTER_UNSUBSCRIBE_SECRET=choose-a-long-random-hex-string
# Admin gate for /admin waitlist view (server-side only — never expose to the client)
ADMIN_PASSWORD=choose-a-long-random-password
ADMIN_SESSION_SECRET=choose-a-long-random-hex-string
